@model List<Calzado.Models.Producto>

<style>
    body {
        background: linear-gradient(135deg, #1a1c20 0%, #2d3436 100%);
        color: #ffffff;
        min-height: 100vh;
    }

    .card-zapato {
        background-color: #ffffff;
        color: #212529;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.2s ease-in-out;
    }

        .card-zapato:hover {
            transform: translateY(-5px);
        }

    .img-zapato {
        height: 190px;
        object-fit: cover;
        width: 100%;
        background-color: #f1f3f5;
    }

    .panel-lateral {
        background-color: #ffffff;
        color: #212529;
        border-radius: 15px;
        padding: 20px;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary gap-3">
        <div>
            <h1 class="h2 fw-bold mb-0">👟 SneakerStore Online</h1>
            <small class="text-light">Explorá el catálogo, guardá tus favoritos e iniciá sesión para comprar</small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span id="badge-usuario" class="badge bg-secondary fs-6 p-2">👤 Invitado (Sin cuenta)</span>
            <span class="badge bg-danger fs-6 p-2">❤️ Deseos: <span id="contador-deseos">0</span></span>
            <span class="badge bg-success fs-6 p-2">🛒 Carrito: <span id="contador-carrito">0</span></span>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var zapato in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow card-zapato border-0">
                            <img src="@zapato.ImagenUrl"
                                 onerror="this.src='https://placehold.co'"
                                 class="img-zapato" alt="@zapato.Modelo">
                            
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-dark">@zapato.Marca</span>
                                    <span class="badge bg-info text-dark">Talla @zapato.Talla</span>
                                </div>
                                
                                <h5 class="card-title fw-bold mb-1">@zapato.Modelo</h5>
                                <p class="text-muted small mb-2">Color: <strong>@zapato.Color</strong></p>
                                
                                <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                                    <span class="fs-5 fw-bold text-success">$@zapato.Precio</span>
                                    <span class="text-secondary small">Stock: @zapato.Stock</span>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-dark btn-sm fw-bold"
                                            onclick="agregarCarrito('@zapato.Id', '@zapato.Modelo', '@zapato.Marca', '@zapato.Precio')">
                                        🛒 Agregar al Carrito
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="agregarDeseo('@zapato.Id', '@zapato.Modelo', '@zapato.Precio')">
                                        ❤️ Lista de Deseos
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div id="panel-login" class="panel-lateral shadow mb-4 border border-warning">
                <h5 class="fw-bold border-bottom pb-2 mb-3">🔐 Mi Cuenta (Requerido para comprar)</h5>
                
                <div id="form-login-box">
                    <div class="mb-2">
                        <input type="email" id="login-correo" class="form-control form-control-sm" placeholder="Correo (ej: cliente@tienda.com)" />
                    </div>
                    <div class="mb-2">
                        <input type="password" id="login-clave" class="form-control form-control-sm" placeholder="Contraseña (1234)" />
                    </div>
                    <button type="button" class="btn btn-warning w-100 btn-sm fw-bold" onclick="conectarCuenta()">
                        Iniciar Sesión
                    </button>
                    <small class="text-muted d-block mt-2" style="font-size: 0.75rem;">
                        Cuentas: <b>cliente@tienda.com</b> / <b>admin@tienda.com</b> (Clave: <b>1234</b>)
                    </small>
                </div>

                <div id="perfil-activo-box" class="d-none">
                    <div class="alert alert-success py-2 px-3 mb-2 small">
                        <strong id="perfil-nombre"></strong> (<span id="perfil-rol"></span>)<br>
                        <span>🪪 ID: <span id="perfil-id-doc"></span></span><br>
                        <span>📍 <span id="perfil-pais"></span> - <span id="perfil-dir"></span></span><br>
                        <span>💳 Tarjeta guardada: **** <span id="perfil-tarjeta"></span></span>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="cerrarSesion()">Cerrar Sesión</button>
                </div>
            </div>

            <div class="panel-lateral shadow mb-4">
                <h4 class="fw-bold border-bottom pb-2">🛒 Tu Carrito de Compras</h4>
                
                <ul id="lista-carrito" class="list-group list-group-flush mb-3">
                    <li class="list-group-item text-muted text-center">Tu carrito está vacío</li>
                </ul>

                <div class="d-flex justify-content-between align-items-center fs-5 fw-bold mb-3">
                    <span>Total a pagar:</span>
                    <span class="text-success">$<span id="total-carrito">0.00</span></span>
                </div>

                <div id="alerta-bloqueo" class="alert alert-danger small py-2 text-center fw-bold">
                    🔒 Iniciá sesión arriba para habilitar el pago
                </div>

                <form id="form-compra" asp-controller="Tienda" asp-action="Comprar" method="post" onsubmit="return confirmarCompra()">
                    <input type="hidden" id="input-usuario-id" name="usuarioId" value="0" />
                    <input type="hidden" id="input-producto-id" name="productoIds" value="" />
                    <input type="hidden" id="input-total" name="precio" value="" />
                    
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Titular de la cuenta:</label>
                        <input type="text" name="clienteNombre" id="cliente-nombre" class="form-control form-control-sm bg-light" readonly required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">🌎 País:</label>
                        <input type="text" name="pais" id="input-pais" class="form-control form-control-sm bg-light" readonly required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Modalidad de entrega:</label>
                        <select name="tipoEntrega" id="select-entrega" class="form-select form-select-sm" onchange="mostrarCamposEntrega()">
                            <option value="Retiro en caja / tienda">🏪 Retirar en caja (Tienda)</option>
                            <option value="Envío a domicilio">🚚 Envío a domicilio (usar dirección guardada)</option>
                        </select>
                    </div>

                    <div id="bloque-direccion" class="mb-2 d-none">
                        <label class="form-label small fw-bold mb-1">📍 Dirección de envío:</label>
                        <input type="text" name="direccion" id="input-direccion" class="form-control form-control-sm" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Método de pago:</label>
                        <select name="metodoPago" id="select-pago" class="form-select form-select-sm" onchange="mostrarCamposPago()">
                            <option value="Tarjeta">💳 Tarjeta guardada en cuenta</option>
                            <option value="Efectivo en caja">💵 Efectivo al retirar en caja</option>
                        </select>
                    </div>

                    <div id="bloque-tarjeta" class="mb-3">
                        <label class="form-label small fw-bold mb-1">💳 Número de tarjeta asociada:</label>
                        <input type="text" name="ultimosDigitos" id="num-tarjeta" class="form-control form-control-sm bg-light" readonly />
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" id="btn-finalizar" class="btn btn-success w-100 fw-bold" disabled>
                            Confirmar Pedido
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="vaciarCarrito()">Vaciar</button>
                    </div>
                </form>
            </div>

            <div class="panel-lateral shadow">
                <h4 class="fw-bold border-bottom pb-2 text-danger">❤️ Lista de Deseos</h4>